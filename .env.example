# Copy to .env and adjust. Values shown are the defaults.

# --- Source SQL dump (opened read-only, never modified) ---
TAWOS_SQL_PATH=D:\Website\Journal_Research\T2_PM-RAG\TAWOS-dataset\TAWOS.sql\TAWOS.sql

# --- Target database (existing XAMPP MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tawos
DB_USER=root
# Leave empty for XAMPP's default passwordless root account.
DB_PASSWORD=

# --- Import tuning ---
IMPORT_BATCH_SIZE=1000
# Flush a batch early when the accumulated row data exceeds this many bytes.
IMPORT_BATCH_MAX_BYTES=8388608
MAX_CONCURRENT_JOBS=2
# skip_existing | fail_on_duplicate | upsert
DEFAULT_DUPLICATE_POLICY=skip_existing
# continue | stop
DEFAULT_ERROR_POLICY=continue
# Row-level failures stored per job in the state DB (all failures go to logs/jobs/*.jsonl).
MAX_STORED_ERRORS=2000
# Abort a job after this many failed rows (0 = never).
MAX_FAILURES_BEFORE_ABORT=0
SESSION_SQL_MODE=STRICT_TRANS_TABLES,NO_AUTO_VALUE_ON_ZERO,NO_ENGINE_SUBSTITUTION
SESSION_TIME_ZONE=+00:00

# Disk check: required = remaining source bytes * factor + reserve.
DISK_SPACE_FACTOR=3.0
DISK_SPACE_RESERVE_GB=2

READER_CHUNK_BYTES=8388608

# --- Application ---
STATE_DIR=state
LOG_DIR=logs
APP_HOST=127.0.0.1
APP_PORT=8000
AUTO_BUILD_INDEX=true
